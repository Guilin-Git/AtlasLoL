# Copie este arquivo para .env e preencha a chave. Nunca versione o .env.
RIOT_API_KEY=RGAPI-COLE_SUA_CHAVE_AQUI

# Destino local para testes. No servidor, o systemd define /mnt/dados/bronze.
ATLAS_BRONZE=./bronze-local

# Endereco usado pela API e pelo Alembic no desenvolvimento local. A senha
# deve ficar somente no .env; no servidor ela vira um segredo provisionado.
ATLAS_DATABASE_URL=postgresql+psycopg://atlas_app:COLE_A_SENHA_AQUI@192.168.3.6:5432/atlas
